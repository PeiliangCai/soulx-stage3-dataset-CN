+            "validation": Path(
+                self.dataset_config.validation_data_path
+            ).resolve(strict=True),
+        }
+        for name, path in configured.items():
+            artifact = manifest["artifacts"][name]
+            if path != Path(artifact["path"]).resolve(strict=True):
